# Copy to blockchain/.env (never commit .env). On Render, set these as environment variables instead.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Local: wallet file created by `npm run setup`. Render: leave unset and use SOLANA_SECRET_KEY.
SOLANA_KEYPAIR_PATH=.secrets/devnet-wallet.json
# Render only: paste the JSON array from .secrets/devnet-wallet.json (keep it secret)
# SOLANA_SECRET_KEY=
# Public key of our wallet (printed by `npm run setup`). Verify only trusts memos signed by this wallet.
MEDCHAIN_WALLET_PUBKEY=9VKhL8xXQLqeUPf8uQZF13mzVZdV9rxbmAUdPeVcXH13
# Shared secret the backend sends in X-API-Key (= backend's SOLANA_SERVICE_API_KEY). Generate: openssl rand -hex 32
CHAIN_SERVICE_API_KEY=8df70d1b229bfc8b1663e2c7f1d7e2f5b5d34c1e96852755b95a48e7ba07eb91
# Local port (Render sets PORT itself). HOST=127.0.0.1 to keep it local-only.
CHAIN_SERVICE_PORT=4010
# Optional: where pending/confirmed records are kept (default .data/records.json)
# CHAIN_STORE_PATH=.data/records.json
