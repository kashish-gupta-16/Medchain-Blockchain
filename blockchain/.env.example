# Copy to blockchain/.env  (never commit .env)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=.secrets/devnet-wallet.json
# Public key of our wallet (printed by `npm run setup`). Verify only trusts memos signed by this wallet.
MEDCHAIN_WALLET_PUBKEY=
# Shared secret that Member 1/2 backend sends in X-API-Key header
CHAIN_SERVICE_API_KEY=change-me
CHAIN_SERVICE_PORT=4010
